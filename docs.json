{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Labrador",
  "theme": "maple",
  "colors": {
    "primary": "#694e32",
    "light": "#e3c18a",
    "dark": "#090807"
  },
  "favicon": "https://media.brand.dev/be90c83a-cc50-4b4e-9301-52e84a71c0a5.png",
  "logo": {
    "light": "/images/3574d316-af81-4ae6-a0a2-21366516309f1SMALL.png",
    "dark": "/images/WhiteLogo.png",
    "href": "https://docs.testwithlabrador.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started Free",
      "href": "https://www.testwithlabrador.com/signup"
