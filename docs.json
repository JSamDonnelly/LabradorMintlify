            ]
          },
          {
            "group": "Projects & auditing",
            "pages": [
              "projects/creating-a-project",
              "projects/managing-pages",
              "projects/user-journeys",
              "projects/auditing-criteria",
              "projects/logging-issues",
              "projects/audit-versions"
            ]
          },
          {
            "group": "Collaboration",
            "pages": [
              "collaboration/team-members",
              "collaboration/comments-and-notifications"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/jira",
              "integrations/chrome-extension"
            ]
          },
          {
            "group": "Exporting reports",
            "pages": [
              "exports/overview",
              "exports/html-reports",
              "exports/vpat-docx",
              "exports/csv-and-jira"
            ]
          },
          {
            "group": "Account & security",
            "pages": [
              "account/account-settings",
              "account/two-factor-authentication",
              "account/trust-and-security"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "help/faq",
              "help/contact-support"
            ]
          }
        ]
      }
    ]
